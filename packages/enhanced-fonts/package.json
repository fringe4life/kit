{
	"name": "@sveltejs/enhanced-fonts",
	"version": "0.1.0",
	"description": "Experimental self-hosted fonts for Svelte and SvelteKit apps",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sveltejs/kit.git",
		"directory": "packages/enhanced-fonts"
	},
	"keywords": [
		"component",
		"enhanced",
		"font",
		"fonts",
		"plugin",
		"svelte",
		"sveltekit",
		"vite"
	],
	"license": "MIT",
	"homepage": "https://svelte.dev/docs/kit",
	"type": "module",
	"scripts": {
		"lint": "oxfmt --check .",
		"check": "node node_modules/@typescript/native/bin/tsc",
		"format": "oxfmt --write .",
		"test": "pnpm test:unit && pnpm test:integration",
		"test:unit": "vitest run test/*.test.js",
		"test:integration": "pnpm -r --workspace-concurrency 1 --filter=\"./test/**\" test"
	},
	"files": [
		"src",
		"types"
	],
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"import": "./src/index.js"
		},
		"./Font.svelte": {
			"types": "./src/Font.svelte.d.ts",
			"svelte": "./src/Font.svelte",
			"default": "./src/Font.svelte"
		},
		"./package.json": "./package.json"
	},
	"types": "types/index.d.ts",
	"dependencies": {
		"unifont": "^1.0.0"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@typescript/native": "catalog:",
		"svelte": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"svelte": "^5.0.0",
		"vite": ">=8.0.12"
	},
	"engines": {
		"node": ">=22"
	}
}
